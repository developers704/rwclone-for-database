<UserControl x:Class="VallianiDataSync.App.Views.DatabaseSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Border Style="{StaticResource SoftPanel}" MaxWidth="580" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock Text="Database" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Connect to your product source. Saved once — stays until you change it."
                   Style="{StaticResource SectionSubtitle}"/>
        <TextBlock Text="Database type" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding ProviderChoices}" SelectedItem="{Binding SelectedProvider}"/>
        <TextBlock Text="Hostname / IP" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Port (MySQL 3306 / SQL Server 1433)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Database name" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Password (DPAPI)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Content="Windows Authentication (SQL Server only)"
                  IsChecked="{Binding UseWindowsAuthentication}"
                  IsEnabled="{Binding IsSqlServer}"/>
        <TextBlock Text="Connection timeout (seconds)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ConnectionTimeout, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
          <Button Content="Test Connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0"/>
          <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
