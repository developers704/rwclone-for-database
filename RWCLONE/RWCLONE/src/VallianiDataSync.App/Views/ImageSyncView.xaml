<UserControl x:Class="VallianiDataSync.App.Views.ImageSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel>
      <TextBlock Text="Image Sync" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Image root folders (one per line; local or UNC)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding RootFoldersText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
        <Button Content="Save Roots" Style="{StaticResource SecondaryButton}" Command="{Binding SaveRootsCommand}" Margin="0,0,8,0"/>
        <Button Content="Sync Images Now" Style="{StaticResource PrimaryButton}" Command="{Binding SyncImagesNowCommand}"/>
      </StackPanel>
      <UniformGrid Columns="5">
        <Border Background="{StaticResource PanelBrush}" Margin="0,0,8,8" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel><TextBlock Text="Total"/><TextBlock Text="{Binding Total}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" Margin="0,0,8,8" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel><TextBlock Text="Pending"/><TextBlock Text="{Binding Pending}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" Margin="0,0,8,8" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel><TextBlock Text="Uploaded"/><TextBlock Text="{Binding Uploaded}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" Margin="0,0,8,8" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel><TextBlock Text="Failed"/><TextBlock Text="{Binding Failed}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" Margin="0,0,0,8" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <StackPanel><TextBlock Text="Missing"/><TextBlock Text="{Binding Missing}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </Border>
      </UniformGrid>
      <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
