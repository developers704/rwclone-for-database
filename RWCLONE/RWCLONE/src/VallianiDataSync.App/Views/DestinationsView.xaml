<UserControl x:Class="VallianiDataSync.App.Views.DestinationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Destinations" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Projects push mapped product fields to an external API (Shopify, custom, etc.)."
                 Style="{StaticResource SectionSubtitle}" Margin="0"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" MinWidth="220"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*" MinWidth="420"/>
      </Grid.ColumnDefinitions>

      <!-- Project rail — no card box -->
      <DockPanel Grid.Column="0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <TextBlock Text="PROJECTS" FontSize="11" FontWeight="Bold"
                     Foreground="{StaticResource MutedBrush}"/>
          <Border Height="2" Width="36" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Background="{StaticResource AccentLineBrush}" CornerRadius="1"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Button Content="+  New project" Style="{StaticResource PrimaryButton}"
                  Command="{Binding AddProjectCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
          <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                  Command="{Binding DeleteProjectCommand}" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,10,2"
                        Background="{StaticResource AccentLineBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Opacity" Value="0.25"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                          <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Paused"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="True">
                            <Setter Property="Text" Value="Active"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Accent divider -->
      <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
              Background="{StaticResource LineBrush}" Opacity="0.85" Margin="0,4,0,4"/>

      <!-- Open form — no outer SoftPanel -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="Project setup" FontFamily="{StaticResource DisplayFont}"
                     FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Pick a project on the left, or create one. Sync sends only mapped format fields."
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

          <!-- OTP — soft strip, not a heavy card -->
          <DockPanel Margin="0,0,0,20" LastChildFill="True">
            <Border DockPanel.Dock="Left" Width="3" Background="{StaticResource AccentLineBrush}"
                    CornerRadius="2" Margin="0,0,12,0"/>
            <StackPanel>
              <TextBlock Text="Admin OTP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="Send OTP" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SendSensitiveOtpCommand}" Margin="0,0,10,0"/>
                <TextBox Width="120" Margin="0,0,8,0"
                         Text="{Binding SensitiveOtp1, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OTP email 1"/>
                <TextBox Width="120"
                         Text="{Binding SensitiveOtp2, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OTP email 2"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>

          <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}"/>

          <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
            <CheckBox Content="Enabled" IsChecked="{Binding SelectedProject.Enabled}" Margin="0,0,22,0"/>
            <CheckBox Content="Auto sync" IsChecked="{Binding SelectedProject.AutoSyncEnabled}"/>
          </StackPanel>

          <TextBlock Text="Auto interval (minutes)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SelectedProject.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                   Width="140" HorizontalAlignment="Left"/>

          <TextBlock Text="API URL" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SelectedProject.ApiUrl, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Text="API key / token" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>

          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,16" Opacity="0.9"/>

          <TextBlock Text="Format" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding FormatFileHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Upload format" Style="{StaticResource PrimaryButton}" Command="{Binding ImportFormatCommand}" Margin="0,0,10,0"/>
            <Button Content="Add field" Style="{StaticResource SecondaryButton}" Command="{Binding AddFormatFieldCommand}"/>
          </StackPanel>

          <DataGrid ItemsSource="{Binding FormatRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                    Height="200" HeadersVisibility="Column" MinRowHeight="32"
                    BorderThickness="0" Background="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Destination key" Binding="{Binding DestinationKey, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              <DataGridComboBoxColumn Header="Source field" Width="*"
                                      ItemsSource="{Binding DataContext.SourceFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItemBinding="{Binding SourceField, UpdateSourceTrigger=PropertyChanged}"/>
              <DataGridTemplateColumn Header="" Width="78">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Delete" Padding="8,2"
                            Command="{Binding DataContext.DeleteFormatFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="{Binding SelectedProject.LastSyncMessage}" Margin="0,12,0,0"
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
            <Button Content="Sync Now" Style="{StaticResource SecondaryButton}" Command="{Binding SyncNowCommand}" Margin="0,0,10,0"/>
            <Button Content="Full Sync" Style="{StaticResource SecondaryButton}" Command="{Binding FullSyncCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
