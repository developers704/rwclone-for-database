<UserControl x:Class="VallianiDataSync.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Logs" Style="{StaticResource SectionTitle}"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox Width="220" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
      <TextBox Width="140" Text="{Binding StoreFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
      <Button Content="Filter" Style="{StaticResource SecondaryButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
      <Button Content="Export" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}"/>
      <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampUtc}" Width="150"/>
        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
        <DataGridTextColumn Header="Store" Binding="{Binding StoreCode}" Width="100"/>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="120"/>
        <DataGridTextColumn Header="Endpoint" Binding="{Binding ApiEndpoint}" Width="160"/>
        <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="140"/>
        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
