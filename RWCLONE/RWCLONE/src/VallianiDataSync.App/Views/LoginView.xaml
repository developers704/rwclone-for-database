<UserControl x:Class="VallianiDataSync.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F2A26" Offset="0"/>
        <GradientStop Color="#163F39" Offset="0.45"/>
        <GradientStop Color="#1A4D45" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Ellipse Width="420" Height="420" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-100,0,0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#2BB89A" Offset="0"/>
          <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="360" Height="360" Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-80">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#A8D8CF" Offset="0"/>
          <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <Border x:Name="LoginCard" Width="440" Padding="36,32" CornerRadius="20"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#F7FAFC" BorderBrush="#C5D2DC" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.55">
      <Border.RenderTransform>
        <TranslateTransform Y="18"/>
      </Border.RenderTransform>
      <StackPanel>
        <TextBlock Text="VALLIANI" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Secure workspace login" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,8"
                   Foreground="{StaticResource InkBrush}"/>
        <TextBlock Text="{Binding EmailHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   FontSize="12.5" Margin="0,0,0,20" LineHeight="18"/>

        <StackPanel Visibility="{Binding OtpRequired, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding OtpLabel1}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
          <TextBox Text="{Binding OtpEmail1, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding OtpLabel2}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
          <TextBox Text="{Binding OtpEmail2, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
          <Button Content="Send OTP" Style="{StaticResource SecondaryButton}" Command="{Binding SendOtpCommand}"
                  Margin="0,0,10,0" Visibility="{Binding OtpRequired, Converter={StaticResource BoolToVisibilityConverter}}"/>
          <Button Content="Unlock" Style="{StaticResource PrimaryButton}" Command="{Binding UnlockCommand}" MinWidth="120"/>
        </StackPanel>

        <Button Content="Can't unlock? Recover access on this PC"
                Command="{Binding RecoverUnlockCommand}"
                Visibility="{Binding ShowRecovery, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                FontSize="12" HorizontalAlignment="Left" Cursor="Hand" Padding="0,4"/>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
