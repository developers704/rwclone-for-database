{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "LocalStateDirectory": "data",
  "LogsDirectory": "logs",
  "Database": {
    "Host": "localhost",
    "Port": 1433,
    "Database": "iTransactDB",
    "Username": "",
    "UseWindowsAuthentication": true,
    "ConnectionTimeoutSeconds": 30
  },
  "Api": {
    "BaseUrl": "https://localhost:7188",
    "StoreId": "",
    "ClientId": "",
    "TimeoutSeconds": 60,
    "RetryCount": 3,
    "RequireHttps": true
  },
  "Sync": {
    "ManualOnly": true,
    "AutomaticEnabled": false,
    "IntervalMinutes": 15,
    "UseDailySchedule": false,
    "DefaultMode": "Incremental",
    "Channels": "All",
    "BatchSize": 200
  },
  "Images": {
    "RootFolders": [],
    "UseChecksum": true,
    "UseModifiedTimestamp": true
  }
}
