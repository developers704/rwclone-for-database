<Window x:Class="VallianiDataSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Valliani Data Sync"
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBgGradient}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Custom Windows title bar (replaces OS chrome) -->
      <Border Grid.Row="0" Background="{StaticResource TopBarGradient}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Image Source="pack://application:,,,/Assets/toplogo.png"
                   Width="34" Height="34" Margin="0,0,10,0"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"/>
            <TextBlock Text="VALLIANI Data Sync"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource BrandGoldBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                    Background="#221C17" BorderBrush="#4A3F32" BorderThickness="1"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#D4AF37" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource SidebarTextBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button Content="Lock" Style="{StaticResource SidebarLockButton}"
                    Command="{Binding LockAppCommand}"
                    Padding="10,4" FontSize="11" MinHeight="26" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="─" Width="40" Height="40" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource BrandGoldBrush}" FontSize="12"
                    Click="Minimize_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="□" Width="40" Height="40" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource BrandGoldBrush}" FontSize="11"
                    Click="Maximize_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="✕" Width="40" Height="40" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource BrandGoldBrush}" FontSize="12"
                    Click="Close_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" Padding="14,14,14,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="2,0,2,14">
              <Image Source="pack://application:,,,/Assets/mainlogo.png"
                     MaxWidth="188" Height="96" Stretch="Uniform"
                     HorizontalAlignment="Left"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     SnapsToDevicePixels="True"/>
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Content="Lock workspace" Style="{StaticResource SidebarLockButton}"
                    Command="{Binding LockAppCommand}" Margin="2,12,2,2"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
              <StackPanel>
                <Button Content="Dashboard" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <Button Content="Database" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Database"/>
                <Button Content="Server / API" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Api"/>
                <Button Content="Stores" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Stores"/>
                <Button Content="Data Mapping" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Mapping"/>
                <Button Content="Sync Settings" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Sync"/>
                <Button Content="Images" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Images"/>
                <TextBlock Text="ADMIN" Style="{StaticResource AdminChip}"/>
                <Button Content="Destinations" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Destinations"/>
                <Button Content="Security / OTP" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Security"/>
                <Button Content="Logs" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Logs"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Padding="20,14">
          <!-- Grid forces finite height so page footers (Remove etc.) stay visible when maximized -->
          <Grid>
            <ContentControl Content="{Binding CurrentPage}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <ContentControl Content="{Binding Login}"
                    Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
  </Grid>
</Window>
