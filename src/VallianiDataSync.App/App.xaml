<Application x:Class="VallianiDataSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VallianiDataSync.App"
             xmlns:views="clr-namespace:VallianiDataSync.App.Views"
             xmlns:vm="clr-namespace:VallianiDataSync.App.ViewModels">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/AppTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DatabaseSettingsViewModel}">
        <views:DatabaseSettingsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ApiSettingsViewModel}">
        <views:ApiSettingsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:StoreManagementViewModel}">
        <views:StoreManagementView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DataMappingViewModel}">
        <views:DataMappingView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SynchronizationSettingsViewModel}">
        <views:SynchronizationSettingsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ImageSyncViewModel}">
        <views:ImageSyncView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LogsViewModel}">
        <views:LogsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DestinationsViewModel}">
        <views:DestinationsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SecuritySettingsViewModel}">
        <views:SecuritySettingsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LoginViewModel}">
        <views:LoginView/>
      </DataTemplate>
      <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
