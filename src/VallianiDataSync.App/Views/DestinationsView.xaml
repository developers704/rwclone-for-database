<UserControl x:Class="VallianiDataSync.App.Views.DestinationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             x:Name="Root"
             Language="en-US" xml:lang="en-US"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="0,0,4,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="200"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Destinations" Style="{StaticResource SectionTitle}" FontSize="22" Margin="0,0,0,2"/>
      <TextBlock Text="One source per project. Pick source → preview → API → Save / Sync."
                 Style="{StaticResource SectionSubtitle}" Margin="0"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176" MinWidth="160"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="400"/>
      </Grid.ColumnDefinitions>

      <!-- Projects: buttons pinned at TOP so maximize never hides Remove -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="PROJECTS" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource MutedBrush}"/>
          <Border Height="2" Width="28" HorizontalAlignment="Left" Margin="0,6,0,0"
                  Background="{StaticResource AccentLineBrush}" CornerRadius="1"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <Button Content="+ New" Style="{StaticResource PrimaryButton}"
                  Command="{Binding AddProjectCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                  MinHeight="32"/>
          <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                  Command="{Binding DeleteProjectCommand}" HorizontalAlignment="Stretch"
                  MinHeight="32"/>
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}"
                 HorizontalContentAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="1,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,8,1"
                        Background="{StaticResource AccentLineBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Opacity" Value="0.25"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                          <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="10.5" Margin="0,1,0,0" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Paused"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="True">
                            <Setter Property="Text" Value="Active"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
              Background="{StaticResource LineBrush}" Opacity="0.85"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <Border Background="#F0EBE3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Padding="10,7" Margin="0,0,0,8" CornerRadius="3">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
          </Border>

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
              <hc:TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}"
                          Height="34" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
              <CheckBox Content="Enabled" IsChecked="{Binding SelectedProject.Enabled}"
                        Margin="0,0,14,6" VerticalAlignment="Center"/>
              <CheckBox Content="Auto sync" IsChecked="{Binding SelectedProject.AutoSyncEnabled}"
                        Margin="0,0,14,6" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="Interval" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <hc:TextBox Text="{Binding SelectedProject.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                            Width="56" Height="30" VerticalContentAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="API URL" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
              <hc:TextBox Text="{Binding SelectedProject.ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                          Height="34" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="API key / token" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
              <hc:TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                          Height="34" VerticalContentAlignment="Center"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300" MinWidth="240"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Source" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
              <hc:ComboBox ItemsSource="{Binding SourceOptions}"
                           SelectedItem="{Binding SelectedSource}"
                           DisplayMemberPath="DisplayName"
                           IsEditable="False"
                           Height="36"
                           hc:InfoElement.Placeholder="Select one source"
                           Style="{StaticResource ComboBoxExtend}"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Visibility="{Binding ShowCaratoneDates, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="Caratone dates (PC today default)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
              <StackPanel Orientation="Horizontal">
                <CheckBox Content="Range" IsChecked="{Binding SelectedProject.SaleDateIsRange, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
                <DatePicker SelectedDate="{Binding SelectedProject.SaleReportDateFrom, Mode=TwoWay}"
                            Width="128" Height="34" Margin="0,0,8,0"
                            Language="en-US" xml:lang="en-US"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
                <DatePicker SelectedDate="{Binding SelectedProject.SaleReportDateTo, Mode=TwoWay}"
                            Width="128" Height="34"
                            Language="en-US" xml:lang="en-US"
                            IsEnabled="{Binding SelectedProject.SaleDateIsRange}"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <WrapPanel Margin="0,2,0,6">
            <Button Content="Load preview" Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadPreviewCommand}" Margin="0,0,6,4" MinHeight="32" MinWidth="100"
                    IsEnabled="{Binding IsIdle}"/>
            <Button Content="Export CSV" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ExportSelectedCsvCommand}" Margin="0,0,6,4" MinHeight="32" MinWidth="96"
                    IsEnabled="{Binding IsIdle}"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" Margin="0,0,6,4" MinHeight="32" MinWidth="72"
                    IsEnabled="{Binding IsIdle}"/>
            <Button Content="Sync Now" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SyncNowCommand}" Margin="0,0,6,4" MinHeight="32" MinWidth="84"
                    IsEnabled="{Binding IsIdle}"/>
            <Button Content="Full Sync" Style="{StaticResource SecondaryButton}"
                    Command="{Binding FullSyncCommand}" Margin="0,0,6,4" MinHeight="32" MinWidth="84"
                    IsEnabled="{Binding IsIdle}"/>
            <Button Content="Send OTP" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SendSensitiveOtpCommand}" Margin="0,0,6,4" MinHeight="32" MinWidth="84"
                    IsEnabled="{Binding IsIdle}"/>
            <hc:TextBox Width="88" Height="32" Margin="0,0,4,4" VerticalContentAlignment="Center"
                        Text="{Binding SensitiveOtp1, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="OTP 1"/>
            <hc:TextBox Width="88" Height="32" Margin="0,0,0,4" VerticalContentAlignment="Center"
                        Text="{Binding SensitiveOtp2, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="OTP 2"/>
          </WrapPanel>

          <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2">
          <DataGrid ItemsSource="{Binding PreviewView}"
                    AutoGenerateColumns="True"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    RowHeaderWidth="0"
                    MinRowHeight="22"
                    FontSize="11.5"
                    Background="#FFFEFB"
                    AlternatingRowBackground="#F7F3EC"
                    BorderThickness="0"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,6" Margin="0,6,0,0"
                Background="#F7F3EC" MaxHeight="72">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding SelectedProject.LastSyncMessage}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="11"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
