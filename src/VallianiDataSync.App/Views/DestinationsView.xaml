<UserControl x:Class="VallianiDataSync.App.Views.DestinationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Grid Margin="0,0,8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Destinations" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Each destination: pick sales / inventory / payments, fields, API URL. Auto sync pushes only when data changes."
                 Style="{StaticResource SectionSubtitle}" Margin="0"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" MinWidth="200"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*" MinWidth="480"/>
      </Grid.ColumnDefinitions>

      <!-- Project rail -->
      <DockPanel Grid.Column="0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
          <TextBlock Text="PROJECTS" FontSize="11" FontWeight="Bold"
                     Foreground="{StaticResource MutedBrush}"/>
          <Border Height="2" Width="36" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Background="{StaticResource AccentLineBrush}" CornerRadius="1"/>
        </StackPanel>

        <UniformGrid DockPanel.Dock="Bottom" Columns="1" Margin="0,16,0,0" Rows="2">
          <Button Content="+ New project" Style="{StaticResource PrimaryButton}"
                  Command="{Binding AddProjectCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                  MinHeight="40"/>
          <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                  Command="{Binding DeleteProjectCommand}" HorizontalAlignment="Stretch"
                  MinHeight="40"/>
        </UniformGrid>

        <ListBox ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,10,2"
                        Background="{StaticResource AccentLineBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Opacity" Value="0.25"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                          <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Paused"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Enabled}" Value="True">
                            <Setter Property="Text" Value="Active"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
              Background="{StaticResource LineBrush}" Opacity="0.85" Margin="0,4,0,4"/>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Project setup" FontFamily="{StaticResource DisplayFont}"
                     FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Pick a project on the left, or create one. Sync sends only selected mapped fields."
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

          <DockPanel Margin="0,0,0,20" LastChildFill="True">
            <Border DockPanel.Dock="Left" Width="3" Background="{StaticResource AccentLineBrush}"
                    CornerRadius="2" Margin="0,0,12,0"/>
            <StackPanel>
              <TextBlock Text="Admin OTP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
              <WrapPanel Orientation="Horizontal">
                <Button Content="Send OTP" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SendSensitiveOtpCommand}" Margin="0,0,10,0" MinHeight="40" MinWidth="110"/>
                <TextBox Width="120" Height="40" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         Text="{Binding SensitiveOtp1, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OTP email 1"/>
                <TextBox Width="120" Height="40" VerticalContentAlignment="Center"
                         Text="{Binding SensitiveOtp2, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OTP email 2"/>
              </WrapPanel>
            </StackPanel>
          </DockPanel>

          <Border Background="#E8F0E8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                  Padding="12,10" Margin="0,0,0,14" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="13"/>
          </Border>

          <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}"
                   MaxWidth="420" HorizontalAlignment="Left" Height="40" VerticalContentAlignment="Center"/>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
            <CheckBox Content="Enabled (must be ON to sync — Paused = no push)"
                      IsChecked="{Binding SelectedProject.Enabled}"
                      Margin="0,0,24,0" VerticalAlignment="Center"/>
            <CheckBox Content="Auto sync" IsChecked="{Binding SelectedProject.AutoSyncEnabled}"
                      VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock Text="Auto interval (minutes)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SelectedProject.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                   Width="140" HorizontalAlignment="Left" Height="40" VerticalContentAlignment="Center"/>

          <TextBlock Text="API URL" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
          <TextBox Text="{Binding SelectedProject.ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                   Height="40" VerticalContentAlignment="Center"/>

          <TextBlock Text="API key / token" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
          <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                   Height="40" VerticalContentAlignment="Center"/>

          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14" Opacity="0.9"/>

          <TextBlock Text="Fixed sources (same on every destination)"
                     FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding FormatFileHint}" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" Margin="0,0,0,8"/>

          <WrapPanel Margin="0,0,0,8">
            <Button Content="Select all sources" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectAllTablesCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="140"/>
            <Button Content="Clear sources" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectNoneTablesCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="120"/>
            <Button Content="Apply ticks" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ApplyTableTicksCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="110"/>
            <Button Content="Load fields" Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadFieldsCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="120"/>
            <Button Content="Select all fields" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectAllFieldsCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="140"/>
            <Button Content="Clear fields" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectNoneFieldsCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="120"/>
            <Button Content="Export CSV" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ExportSelectedCsvCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="120"
                    ToolTip="Exports selected sources as CSV into Documents\VallianiDataSync\csv-export (no folder picker)"/>
          </WrapPanel>

          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12"
                  Background="#F7F8F5">
            <StackPanel>
              <TextBlock Text="caratone-sale / caratone-payment dates" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBlock Text="Single day = range OFF. Range = From→To inclusive. Required when either caratone source is ticked."
                         TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" FontSize="12"/>
              <CheckBox Content="Date range (unchecked = single day)"
                        IsChecked="{Binding SelectedProject.SaleDateIsRange, Mode=TwoWay}"
                        Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="From" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                  <DatePicker SelectedDate="{Binding SelectedProject.SaleReportDateFrom, Mode=TwoWay}"
                              Width="160" Height="32"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="To (range only)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                  <DatePicker SelectedDate="{Binding SelectedProject.SaleReportDateTo, Mode=TwoWay}"
                              Width="160" Height="32"
                              IsEnabled="{Binding SelectedProject.SaleDateIsRange}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Sources — tick which to sync for this destination" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DataGrid ItemsSource="{Binding Tables}" AutoGenerateColumns="False" CanUserAddRows="False"
                    Height="160" HeadersVisibility="Column" MinRowHeight="32"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="Transparent" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                    IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Sync" Width="64">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Source" Binding="{Binding TableName}" IsReadOnly="True" Width="100"/>
              <DataGridTextColumn Header="Description" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Source fields — Load fields, then Select all or tick one by one (empty = all columns)"
                     FontWeight="SemiBold" Margin="0,14,0,6" TextWrapping="Wrap"/>
          <DataGrid ItemsSource="{Binding Columns}" AutoGenerateColumns="False" CanUserAddRows="False"
                    Height="240" HeadersVisibility="Column" MinRowHeight="32"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="Transparent" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                    IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Sync" Width="64">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Source" Binding="{Binding TableName}" IsReadOnly="True" Width="100"/>
              <DataGridTextColumn Header="Field" Binding="{Binding ColumnName}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Last sync report" Margin="0,12,0,4" FontWeight="SemiBold"/>
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,0"
                  Background="#F7F8F5" MaxHeight="180">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="{Binding SelectedProject.LastSyncMessage}"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
          </Border>

          <WrapPanel Margin="0,18,0,8">
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="100"/>
            <Button Content="Sync Now" Style="{StaticResource SecondaryButton}"
                    Command="{Binding SyncNowCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="110"/>
            <Button Content="Full Sync" Style="{StaticResource SecondaryButton}"
                    Command="{Binding FullSyncCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="110"/>
            <Button Content="Export CSV" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ExportSelectedCsvCommand}" Margin="0,0,8,8" MinHeight="40" MinWidth="120"/>
          </WrapPanel>
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                     Margin="0,0,0,16"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
