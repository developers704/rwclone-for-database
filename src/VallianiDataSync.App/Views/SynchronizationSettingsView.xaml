<UserControl x:Class="VallianiDataSync.App.Views.SynchronizationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Text="Synchronization Settings" Style="{StaticResource SectionTitle}"/>
      <CheckBox Content="Manual sync only" IsChecked="{Binding ManualOnly}"/>
      <CheckBox Content="Automatic sync" IsChecked="{Binding AutomaticEnabled}"/>
      <TextBlock Text="Sync every X minutes" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Content="Use daily schedule" IsChecked="{Binding UseDailySchedule}"/>
      <TextBlock Text="Daily at (HH:mm)" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding DailyAt, UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Content="Default to full sync" IsChecked="{Binding FullByDefault}"/>
      <TextBlock Text="Channels" FontWeight="SemiBold" Margin="0,8,0,4"/>
      <CheckBox Content="Products" IsChecked="{Binding SyncProducts}"/>
      <CheckBox Content="Inventory" IsChecked="{Binding SyncInventory}"/>
      <CheckBox Content="Prices" IsChecked="{Binding SyncPrices}"/>
      <CheckBox Content="Images" IsChecked="{Binding SyncImages}"/>
      <TextBlock Text="Batch size" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="Selected store code" Style="{StaticResource FieldLabel}"/>
      <TextBox Text="{Binding SelectedStoreCode, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
      <TextBlock Text="{Binding StatusMessage}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
