<UserControl x:Class="VallianiDataSync.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border CornerRadius="18" Padding="22,18" Margin="0,0,0,20" Background="{StaticResource HeroWash}">
        <Grid>
          <StackPanel>
            <TextBlock Text="VALLIANI" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                       Foreground="#D4AF37" Margin="0,0,0,4"/>
            <TextBlock Text="Dashboard" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                       Foreground="#F5EFE4"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#D9CDB8" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <UniformGrid Columns="3" Margin="0,0,0,8">
        <Border Style="{StaticResource StatTile}">
          <StackPanel>
            <TextBlock Text="Database" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding DatabaseStatus}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}">
          <StackPanel>
            <TextBlock Text="API / Server" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding ApiStatus}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Selected store" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding SelectedStore}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}">
          <StackPanel>
            <TextBlock Text="Last successful sync" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding LastSuccessfulSync}" FontSize="15"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}">
          <StackPanel>
            <TextBlock Text="Next scheduled sync" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding NextScheduledSync}" FontSize="15"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Total products" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding TotalProducts}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}">
          <StackPanel>
            <TextBlock Text="Uploaded" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding RecordsUploaded}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}">
          <StackPanel>
            <TextBlock Text="Updated" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding RecordsUpdated}" FontSize="18" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatTile}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Failed / Pending images" Style="{StaticResource FieldLabel}"/>
            <TextBlock FontSize="18" FontWeight="SemiBold">
              <Run Text="{Binding FailedRecords, Mode=OneWay}"/>
              <Run Text=" / "/>
              <Run Text="{Binding PendingImages, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </Border>
      </UniformGrid>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
        <Button Content="Sync Now" Style="{StaticResource PrimaryButton}" Command="{Binding SyncNowCommand}" Margin="0,0,10,0"/>
        <Button Content="Full Sync" Style="{StaticResource SecondaryButton}" Command="{Binding FullSyncCommand}" Margin="0,0,10,0"/>
        <Button Content="Stop Sync" Style="{StaticResource SecondaryButton}" Command="{Binding StopSyncCommand}" Margin="0,0,10,0"/>
        <Button Content="View Logs" Style="{StaticResource SecondaryButton}" Command="{Binding ViewLogsCommand}"/>
      </StackPanel>

      <Border Style="{StaticResource SoftPanel}">
        <StackPanel>
          <TextBlock Text="Recent errors" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <ListBox ItemsSource="{Binding RecentErrors}" Height="150" BorderThickness="0" Background="Transparent"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
