<UserControl x:Class="VallianiDataSync.App.Views.ApiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <Border Style="{StaticResource SoftPanel}" MaxWidth="580" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock Text="Server / API" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Connect once to your Valliani API. Settings stay saved after Save."
                   Style="{StaticResource SectionSubtitle}"/>
        <TextBlock Text="API Base URL (HTTPS)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Store ID (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding StoreId, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Client ID (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Timeout (seconds)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Retry count" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
          <Button Content="Test API" Style="{StaticResource SecondaryButton}" Command="{Binding TestApiCommand}" Margin="0,0,10,0"/>
          <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
